<Project Sdk="Microsoft.NET.Sdk">

  <!-- SHARED project: holds the DTOs (data shapes) used by BOTH the API and the Blazor client.
       Think of it as a common "language" that both sides speak, so they never disagree. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

</Project>
